{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "kind": {
                "type": "string",
                "enum": ["fact", "inference", "hypothesis"]
              },
              "evidence_event_ids": {
                "type": "array",
                "minItems": 0,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "required": ["text", "kind", "evidence_event_ids"],
            "additionalProperties": false
          }
        },
        "intent_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "hunger",
                  "rest",
                  "work",
                  "entertainment",
                  "travel",
                  "purchase",
                  "communication",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "enum": ["stated", "inferred", "uncertain"]
              }
            },
            "required": ["intent", "basis"],
            "additionalProperties": false
          }
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": ["claims", "intent_candidates", "uncertainty"],
      "additionalProperties": false
    }
  },
  "required": ["target"],
  "additionalProperties": false
}
