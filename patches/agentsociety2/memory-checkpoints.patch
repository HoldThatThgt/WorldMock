+    async def _run_person_step(self, tick: int, t: datetime) -> tuple[str, dict[str, int]]:
+        """@brief 执行人物步骤主体并收集计数。
+
+        :param tick: 当前决策跨度秒数。
+        :param t: 当前模拟时间。
+        :returns: 结果摘要和追踪计数。
+        """
+        self._refresh_visible_skills()
+        self.persist_agent_json(tick=tick, t=t)
+        pre_hooks = await self.run_lifecycle_hooks("pre_step", tick=tick, t=t)
+        observation = await self._observe_environment()
+        request = ReactLoopRequest(
+            tick,
+            t,
+            [self._observation_record(observation)],
+            skill_hooks=self._skill_hook_context(pre_hooks),
+        )
+        result = await self.run_react_loop(request)
+        post_hooks = await self.run_lifecycle_hooks("post_step", tick=tick, t=t)
+        outcome = await self._memory_runtime.after_step(
+            tick=tick,
+            t=t,
+            step_count=self._step_count,
+            finish_memories=self._last_finish_memories,
+            sleep_boundary=self.memory_sleep_boundary(),
+        )
+        await self._record_memory_update(outcome)
+        counts = {
+            "skill.pre_hook_count": len(pre_hooks),
+            "skill.post_hook_count": len(post_hooks),
+            "memory.episode_count": len(outcome.created_episodes) + len(outcome.merged_episodes),
+        }
+        return result, counts
+
+    async def _record_memory_update(self, outcome: MemoryStepOutcome) -> None:
+        """@brief 登记本次已完整落盘的人物记忆内容身份。
+
+        :param outcome: 当前步骤写入的主观记忆与事实视图结果。
+        """
+        context = getattr(self, "_decision_context", None)
+        store = self._memory_runtime.store
+        if context is None or store is None:
+            return
+        if self._env is None:
+            raise RuntimeError("Environment is not initialized")
+        memory_sha256 = _sha256_file(store.memory_md_path)
+        created = tuple(str(item["id"]) for item in outcome.created_episodes)
+        merged = tuple(str(item["id"]) for item in outcome.merged_episodes)
+        episode_snapshots = tuple(
+            {key: str(item[key]) for key in ("id", "type", "text", "epistemic_status")}
+            for item in outcome.created_episodes + outcome.merged_episodes
+        )
+        if not created and not merged and outcome.memory_before_sha256 == memory_sha256:
+            return
+        evidence = MemoryUpdateEvidence(
+            context=context, operation="append_episodes" if created or merged else "refresh_summary",
+            created_episode_ids=created, merged_episode_ids=merged,
+            episodes=episode_snapshots,
+            memory_before_sha256=outcome.memory_before_sha256 or "",
+            memory_sha256=memory_sha256, episodes_sha256=_sha256_file(store.episodes_path),
+            state_sha256=_sha256_file(store.state_path), consolidated=outcome.consolidated,
+            observation_event_id=outcome.observation_event_id,
+            verified_event_ids=outcome.verified_event_ids,
+        )
+        await self._env.record_memory_update(evidence)
+
+    async def _observe_environment(self) -> Any:
+        """@brief 执行必须成功的初始环境观察。
+
+        :returns: 环境观察投影。
+        :raises RuntimeError: 环境尚未初始化。
+        """
+        if self._env is None:
+            raise RuntimeError("Environment is not initialized")
+        _, observation = await self.ask_env({"id": self.id}, "<observe>", readonly=True)
+        return observation
+
+    @staticmethod
+    def _observation_record(observation: Any) -> dict[str, Any]:
+        """@brief 通用人物保持上游的文字观察投影，宿主可以覆写此钩子。"""
+        return {"turn": 0, "action": "observe", "ok": True, "observation": str(observation or "")}
+
+    @staticmethod
+    def _skill_hook_context(items: list[dict[str, Any]]) -> list[dict[str, Any]] | None:
+        """@brief 筛选可展示的生命周期输出。
+
+        :param items: 生命周期执行结果。
+        :returns: 可放入提示的输出。
+        """
+        hooks = [
+            {
+                "skill": item["skill_id"],
+                "hook": item["hook_type"],
+                "ok": item["ok"],
+                "output": item["stdout"],
+            }
+            for item in items
+            if item.get("ok") and item.get("stdout")
+        ]
+        return hooks or None
