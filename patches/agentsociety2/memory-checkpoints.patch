+    def _validate_episode_record(self, item: Any, line_number: int) -> None:
+        """校验一条已持久化记忆的字段、类型和人物身份。
+
+        :param item: JSON 解码后的记录。
+        :param line_number: 用于英文错误定位的文件行号。
+        """
+        if not isinstance(item, dict) or set(item) != PERSISTED_EPISODE_FIELDS:
+            raise ValueError(f"Memory episode line {line_number} has an invalid schema")
+        integer_fields = (
+            "agent_id",
+            "tick",
+            "tick_duration_sec",
+            "step_index",
+            "step_count",
+            "merge_count",
+        )
+        if any(type(item[name]) is not int or item[name] < 1 for name in ("step_index", "merge_count")):
+            raise ValueError(f"Memory episode line {line_number} has invalid counters")
+        if any(type(item[name]) is not int or item[name] < 0 for name in integer_fields):
+            raise ValueError(f"Memory episode line {line_number} has invalid counters")
+        if item["agent_id"] != self.agent_id or item["step_index"] != item["step_count"]:
+            raise ValueError(f"Memory episode line {line_number} has inconsistent identity")
+        if item["type"] not in MEMORY_EPISODE_TYPES:
+            raise ValueError(f"Memory episode line {line_number} has an invalid type")
+        if item["epistemic_status"] != "subjective":
+            raise ValueError(f"Memory episode line {line_number} has an invalid epistemic status")
+        importance = item["importance"]
+        if isinstance(importance, bool) or not isinstance(importance, (int, float)):
+            raise ValueError(f"Memory episode line {line_number} has invalid importance")
+        if not 0.0 <= float(importance) <= 1.0:
+            raise ValueError(f"Memory episode line {line_number} has invalid importance")
+        strings = (item["id"], item["time"], item["text"], item["source"])
+        lists = (item["keywords"], item["refs"])
+        if any(not isinstance(value, str) or not value for value in strings):
+            raise ValueError(f"Memory episode line {line_number} has empty text fields")
+        if any(not isinstance(value, list) or any(not isinstance(text, str) for text in value) for value in lists):
+            raise ValueError(f"Memory episode line {line_number} has invalid string lists")
+
