+"""@brief 承载直接环境路由的单写入 Ray actor。"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+_CACHED_ACTOR_CLASSES: dict[int, Any] = {}
+
+
+@dataclass(frozen=True, slots=True)
+class DirectEnvActorSpec:
+    """@brief 定义直接环境 actor 的可序列化构造输入。
+
+    :param env_module_types: 环境注册类名。
+    :param env_kwargs: 各环境构造参数。
+    :param run_dir: 当前运行目录。
+    :param custom_root: 包含 custom 目录的项目根。
+    :param llm_clients_spec: 注入的模型客户端。
+    :param replay_proxy: 可选原生回放代理。
+    :param trace_proxy: 可选原生追踪代理。
+    """
+
+    env_module_types: tuple[str, ...]
+    env_kwargs: dict[str, dict[str, Any]]
+    run_dir: str
+    custom_root: str
+    llm_clients_spec: dict[str, Any]
+    replay_proxy: Any = None
+    trace_proxy: Any = None
+
+
+class DirectEnvActor:
+    """@brief 在单一 Ray 进程内持有直接环境路由。"""
+
+    def __init__(self, spec: DirectEnvActorSpec) -> None:
+        """@brief 扫描自定义模块并构造环境。
+
+        :param spec: actor 构造合同。
+        """
+        from agentsociety2.env.router_direct import DirectRouter
+        from agentsociety2.registry import (
+            get_env_module_class,
+            scan_and_register_custom_modules,
+        )
+
+        scan_and_register_custom_modules(Path(spec.custom_root))
+        modules = []
+        for module_type in spec.env_module_types:
+            env_class = get_env_module_class(module_type)
+            if env_class is None:
+                raise ValueError(f"Environment class not found: {module_type}")
+            modules.append(env_class(**spec.env_kwargs.get(module_type, {})))
+        self._router = DirectRouter(
+            env_modules=modules,
+            replay_writer=None,
+            llm_clients_spec=spec.llm_clients_spec,
+        )
+        self._bind_runtime(spec)
+
+    def _bind_runtime(self, spec: DirectEnvActorSpec) -> None:
+        """@brief 绑定运行目录、追踪与回放服务。
+
+        :param spec: actor 构造合同。
+        """
+        self._router.run_dir = Path(spec.run_dir)
+        self._router.bind_env_workspaces(
+            Path(spec.run_dir) / "env",
+            list(spec.env_module_types),
+        )
+        self._replay_proxy = spec.replay_proxy
+        if spec.trace_proxy is not None:
+            from agentsociety2.trace import build_local_sink
+
+            sink = build_local_sink(spec.trace_proxy)
+            if sink is not None:
+                self._router.set_trace_sink(sink)
+
+    async def init(self, start_datetime: datetime) -> bool:
+        """@brief 初始化环境并严格恢复已存在状态。
+
+        :param start_datetime: 仿真开始时间。
+        :returns: 环境是否执行了恢复。
+        """
+        if self._replay_proxy is not None:
+            self._router.set_replay_writer(self._replay_proxy)
+        return await self._router.init(start_datetime)
+
+    async def set_current_time(self, value: datetime) -> None:
+        """@brief 同步并确认共享时钟。
+
+        :param value: 当前模拟时间。
+        """
+        self._router.set_current_time(value)
+
+    async def begin_decision_round(self, contexts: tuple[Any, ...]) -> str:
+        """@brief 登记共同决策轮。
+
+        :param contexts: 稳定顺序的决策上下文。
+        :returns: 环境确认的轮身份。
+        """
+        return await self._router.begin_decision_round(contexts)
+
+    async def observe(self, context: Any) -> Any:
+        """@brief 取得人物观察。
+
+        :param context: 人物决策上下文。
+        :returns: 环境观察投影。
+        """
+        return await self._router.observe(context)
+
+    async def submit_action(self, call: Any) -> Any:
+        """@brief 登记人物动作。
+
+        :param call: 直接工具调用。
+        :returns: 提交收据。
+        """
+        return await self._router.submit_action(call)
+
+    async def commit_decision_round(self, round_id: str) -> Any:
+        """@brief 结算完整决策轮。
+
+        :param round_id: 决策轮身份。
+        :returns: 动作结算结果。
+        """
+        return await self._router.commit_decision_round(round_id)
+
+    async def abort_decision_round(self, round_id: str, error: str) -> None:
+        """@brief 中止失败决策轮。
+
+        :param round_id: 决策轮身份。
+        :param error: 英文失败说明。
+        """
+        await self._router.abort_decision_round(round_id, error)
+
+    async def scheduling_state(self) -> Any:
+        """@brief 取得严格调度状态。
+
+        :returns: 环境调度状态。
+        """
+        return await self._router.scheduling_state()
+
+    async def record_model_exchange(self, exchange: Any) -> None:
+        """@brief 保存模型交换证据。
+
+        :param exchange: 模型请求或响应证据。
+        """
+        await self._router.record_model_exchange(exchange)
+
+    async def record_memory_update(self, evidence: Any) -> None:
+        """@brief 保存人物工作区记忆内容身份。
+
+        :param evidence: 人物记忆更新证据。
+        """
+        await self._router.record_memory_update(evidence)
+
+    async def apply_counterfactual(self, intervention: Any) -> Any:
+        """@brief 应用一次已绑定分支身份的封闭世界条件干预。
+
+        :param intervention: 严格反事实干预模型。
+        :returns: 环境提交的反事实收据。
+        """
+        return await self._router.apply_counterfactual(intervention)
+
+    async def checkpoint(self, request: Any) -> Any:
+        """@brief 创建唯一共同检查点。
+
+        :param request: 人物工作区快照请求。
+        :returns: 环境检查点身份。
+        """
+        return await self._router.checkpoint(request)
+
+    async def fail_run(self, error: str) -> None:
+        """@brief 登记运行级致命错误。
+
+        :param error: 英文失败说明。
+        """
+        await self._router.fail_run(error)
+
+    async def step(self, tick: int, t: datetime) -> None:
+        """@brief 推进至严格未来边界。
+
+        :param tick: 推进秒数。
+        :param t: 推进结束时间。
+        """
+        await self._router.step(tick, t)
+
+    async def close(self) -> None:
+        """@brief 关闭环境资源。"""
+        await self._router.close()
+
+
+def get_direct_env_actor_class(max_concurrency: int = 1) -> Any:
+    """@brief 取得固定并发度的直接环境 Ray actor 类。
+
+    :param max_concurrency: actor 接收调用的最大并发度。
+    :returns: 经 Ray 装饰的 actor 类。
+    """
+    if max_concurrency != 1:
+        raise ValueError("Direct environment actor must use max_concurrency=1")
+    if max_concurrency not in _CACHED_ACTOR_CLASSES:
+        import ray
+
+        actor = ray.remote(max_concurrency=max_concurrency)(DirectEnvActor)
+        _CACHED_ACTOR_CLASSES[max_concurrency] = actor
+    return _CACHED_ACTOR_CLASSES[max_concurrency]
