+++ b/agentsociety2/env/router_direct.py
@@ -0,0 +1,167 @@
+"""@brief 不经过模型或代码生成的环境路由。"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+
+from agentsociety2.env.router_base import RouterBase
+
+__all__ = ["DIRECT_ENVIRONMENT_METHODS", "DirectRouter"]
+
+DIRECT_ENVIRONMENT_METHODS = (
+    "begin_decision_round",
+    "observe",
+    "submit_action",
+    "commit_decision_round",
+    "abort_decision_round",
+    "scheduling_state",
+    "record_model_exchange",
+    "record_memory_update",
+    "apply_counterfactual",
+    "checkpoint",
+    "fail_run",
+)
+
+
+class DirectRouter(RouterBase):
+    """@brief 将有类型调用直接委托给唯一支持决策轮的环境模块。"""
+
+    def _environment(self) -> Any:
+        """@brief 取得唯一实现完整直接调用合同的环境。
+
+        :returns: 直接调用环境。
+        :raises RuntimeError: 环境数量不是一个或合同不完整。
+        """
+        matches = [
+            module
+            for module in self.env_modules
+            if all(callable(getattr(module, name, None)) for name in DIRECT_ENVIRONMENT_METHODS)
+        ]
+        if len(matches) != 1:
+            raise RuntimeError("DirectRouter requires exactly one direct environment")
+        return matches[0]
+
+    async def init(self, start_datetime: datetime) -> bool:
+        """@brief 初始化直接环境且不触发旧工作区恢复路径。
+
+        :param start_datetime: 仿真开始或明确恢复时间。
+        :returns: 构造参数是否声明打开已有运行。
+        """
+        self.t = start_datetime
+        for module in self.env_modules:
+            await module.init(start_datetime)
+        return any(bool(getattr(module, "open_existing", False)) for module in self.env_modules)
+
+    async def ask(self, *args: Any, **kwargs: Any) -> tuple[dict, str]:
+        """@brief 拒绝文本环境路由。
+
+        :param args: 未使用的位置参数。
+        :param kwargs: 未使用的关键字参数。
+        :raises RuntimeError: 直接路由不接受文本请求。
+        """
+        del args, kwargs
+        raise RuntimeError("DirectRouter does not accept text environment requests")
+
+    async def begin_decision_round(self, contexts: tuple[Any, ...]) -> str:
+        """@brief 登记共同观察和稳定结算顺序。
+
+        :param contexts: 本轮按结算顺序排列的决策上下文。
+        :returns: 环境确认的决策轮身份。
+        """
+        return await self._environment().begin_decision_round(contexts)
+
+    async def observe(self, context: Any) -> Any:
+        """@brief 读取人物在共同版本可见的观察。
+
+        :param context: 当前人物决策上下文。
+        :returns: 环境观察投影。
+        """
+        return await self._environment().observe(context)
+
+    async def submit_action(self, call: Any) -> Any:
+        """@brief 登记一个有类型的生活动作请求。
+
+        :param call: 宿主补齐身份的直接工具调用。
+        :returns: 环境提交收据。
+        """
+        return await self._environment().submit_action(call)
+
+    async def commit_decision_round(self, round_id: str) -> Any:
+        """@brief 按登记顺序结算完整决策轮。
+
+        :param round_id: 决策轮身份。
+        :returns: 动作结算结果。
+        """
+        return await self._environment().commit_decision_round(round_id)
+
+    async def abort_decision_round(self, round_id: str, error: str) -> None:
+        """@brief 终止未完整结束的决策轮。
+
+        :param round_id: 决策轮身份。
+        :param error: 英文失败说明。
+        """
+        await self._environment().abort_decision_round(round_id, error)
+
+    async def scheduling_state(self) -> Any:
+        """@brief 读取当前时间、就绪人物和下一边界。
+
+        :returns: 严格调度状态。
+        """
+        return await self._environment().scheduling_state()
+
+    async def record_model_exchange(self, exchange: Any) -> None:
+        """@brief 记录模型请求或响应证据。
+
+        :param exchange: 由人物运行时形成的模型交换证据。
+        """
+        await self._environment().record_model_exchange(exchange)
+
+    async def record_memory_update(self, evidence: Any) -> None:
+        """@brief 记录人物工作区记忆内容身份。
+
+        :param evidence: 由人物运行时形成的记忆更新证据。
+        """
+        await self._environment().record_memory_update(evidence)
+
+    async def apply_counterfactual(self, intervention: Any) -> Any:
+        """@brief 应用一次已绑定分支身份的封闭世界条件干预。
+
+        :param intervention: 严格反事实干预模型。
+        :returns: 环境提交的反事实收据。
+        """
+        return await self._environment().apply_counterfactual(intervention)
+
+    async def checkpoint(self, request: Any) -> Any:
+        """@brief 委托环境形成唯一 SQLite 共同检查点。
+
+        :param request: AS2 人物工作区快照请求。
+        :returns: 环境返回的检查点身份。
+        """
+        return await self._environment().checkpoint(request)
+
+    async def fail_run(self, error: str) -> None:
+        """@brief 登记运行级致命错误。
+
+        :param error: 英文失败说明。
+        """
+        await self._environment().fail_run(error)
+
+    async def from_workspaces(self) -> bool:
+        """@brief 严格恢复已绑定环境工作区。
+
+        :returns: 是否有环境恢复了状态。
+        :raises Exception: 任一环境恢复失败。
+        """
+        restored = []
+        for module in self.env_modules:
+            if module._workspace_root is not None:
+                restored.append(await module.restore(module._workspace_root))
+        return any(restored)
+
+    async def to_workspaces(self) -> None:
+        """@brief 拒绝创建第二套环境检查点权威。
+
+        :raises RuntimeError: 直接环境只允许 SQLite 共同检查点。
+        """
+        raise RuntimeError("DirectRouter requires the environment checkpoint contract")
