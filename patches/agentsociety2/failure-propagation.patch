+        """
+        context = self.require_decision_context()
+        self._model_call_sequence += 1
+        call_id = f"{context.decision_id}:model:{self._model_call_sequence:04d}:attempt:{attempt}"
+        self._last_model_call_id = call_id
+        return call_id
