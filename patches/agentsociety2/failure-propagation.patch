+"""@brief AgentBase 的工具执行、ReAct 循环与待办运行职责。"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Mapping
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from agentsociety2.agent.base.react import (
+    ModelCallEvidence,
+    ReactDecision,
+    ReactLoopRequest,
+    ReactToolResult,
+)
+from agentsociety2.agent.base.todo import TodoStateStore
+from agentsociety2.config.llm_dispatcher import collect_transport_attempts
+from agentsociety2.agent.base.tool_schema import react_tool_schemas
+from agentsociety2.logger import get_logger
+
+logger = get_logger()
+AGENT_JSON_PATH = "AGENT.json"
+_SHORT_CLOCK_RE = re.compile(r"^(?P<hour>[01]?\d|2[0-3]):(?P<minute>[0-5]\d)$")
+
+
+def _brief_memories_summary(memories: Any) -> str:
+    """@brief 从 finish 记忆形成短小步骤摘要。
+
+    :param memories: finish 工具提交的记忆列表。
+    :returns: 第一条可用记忆的摘要。
+    """
+    if not isinstance(memories, list) or not memories:
+        return ""
+    first = memories[0]
+    if isinstance(first, dict):
+        return str(first.get("text") or "").strip()[:160]
+    if isinstance(first, str):
+        return first.strip()[:160]
+    return ""
+
+
+class AgentRuntimeMixin:
+    """@brief 为 AgentBase 提供单一工具执行与 ReAct 编排实现。"""
+
+    async def _execute_react_tool(
+        self,
+        decision: ReactDecision,
+        *,
+        readonly: bool = False,
+    ) -> ReactToolResult:
+        """@brief 在追踪跨度内执行一个已验证的 ReAct 工具。
+
+        :param decision: 已解析的 ReAct 决定。
+        :param readonly: 是否禁止状态修改工具。
+        :returns: 工具执行结果。
+        """
+        action = decision.action
+        args = decision.args
+        with self.trace_span(
+            "react.tool",
+            attributes={
+                "operation.type": "react",
+                "react.action": action,
+            },
+        ) as span:
+            result = await self.dispatch_react_tool(action, args, readonly=readonly)
+            update: dict[str, Any] = {
+                "result.ok": result.ok,
+                "output.summary": {
+                    "observation": result.observation,
+                },
+            }
+            if result.data:
+                update["tool.data"] = result.data
+            span.attributes.update(update)
+            return result
+
+    # ------------------------------------------------------------------
+    # Core dispatch
+    # ------------------------------------------------------------------
+
+    async def dispatch_react_tool(
+        self,
+        action: str,
+        args: dict[str, Any],
+        *,
+        readonly: bool = False,
+    ) -> ReactToolResult:
+        """@brief 分派通用工作区、技能或文本环境工具。
+
+        :param action: 工具名。
+        :param args: 工具参数。
+        :param readonly: 是否禁止改变状态。
+        :returns: 工具执行结果。
+        """
+        try:
+            if readonly and action in {"write", "append"}:
+                return self._readonly_rejection(action)
+            if action in {"read", "write", "append", "list", "grep"}:
+                return await self._dispatch_workspace_tool(action, args)
+            skill_actions = {
+                "activate_skill",
+                "deactivate_skill",
+                "read_skill_file",
+                "execute_skill_script",
+            }
+            if action in skill_actions:
+                return await self._dispatch_skill_tool(action, args, readonly)
+            if action == "ask_env":
+                return await self._dispatch_env_tool(args, readonly)
+            return ReactToolResult(False, f"unknown action: {action}", {"action": action})
+        except Exception as exc:
+            logger.error("Agent %s tool %s failed: %s", self.id, action, exc)
+            return ReactToolResult(False, str(exc), {"error": str(exc)})
+
+    @staticmethod
+    def _readonly_rejection(action: str) -> ReactToolResult:
+        """@brief 形成只读模式拒绝结果。
+
+        :param action: 被拒绝的工具名。
+        :returns: 结构化拒绝结果。
+        """
+        return ReactToolResult(
+            False,
+            f"{action} is disabled in readonly mode",
+            {"action": action, "readonly": True},
+        )
+
+    async def _dispatch_workspace_tool(
+        self,
+        action: str,
+        args: dict[str, Any],
+    ) -> ReactToolResult:
+        """@brief 分派工作区工具。
+
+        :param action: 工作区工具名。
+        :param args: 工具参数。
+        :returns: 工具执行结果。
+        """
+        handlers = {
+            "read": self._read_workspace,
+            "write": self._write_workspace,
+            "append": self._append_workspace,
+            "list": self._list_workspace,
+            "grep": self._grep_workspace,
+        }
+        return await handlers[action](args)
+
+    async def _read_workspace(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 读取工作区或已启用技能文件。
+
+        :param args: 含 path 的工具参数。
+        :returns: 文件内容。
+        """
+        requested = str(args.get("path") or "")
+        path = self._normalize_workspace_read_path(requested)
+        try:
+            content = self._workspace.read_text(path)
+            return ReactToolResult(True, content, {"path": path})
+        except ValueError:
+            resolved = self._try_read_skill_path(requested or path)
+            if resolved is None:
+                raise
+            skill_id, relative, content = resolved
+            data = {"skill_id": skill_id, "path": relative, "redirected_from": requested}
+            return ReactToolResult(True, content, data)
+
+    async def _write_workspace(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 写入非核心工作区文件。
+
+        :param args: 含 path 与 content 的工具参数。
+        :returns: 写入结果。
+        """
+        path = str(args.get("path") or "")
+        if self._is_core_owned_workspace_path(path):
+            return ReactToolResult(
+                False,
+                f"{path} is managed by the agent runtime",
+                {"path": path, "core_owned": True},
+            )
+        result = self._workspace.write_text(path, str(args.get("content") or ""))
+        return ReactToolResult(
+            True,
+            f"written: {path}",
+            {"path": str(self._workspace.resolve(path)), "bytes": result.bytes_written},
+        )
+
+    async def _append_workspace(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 追加非核心工作区文件。
+
+        :param args: 含 path 与 content 的工具参数。
+        :returns: 追加结果。
+        """
+        path = str(args.get("path") or "")
+        if self._is_core_owned_workspace_path(path):
+            return ReactToolResult(
+                False,
+                f"{path} is managed by the agent runtime",
+                {"path": path, "core_owned": True},
+            )
+        result = self._workspace.append_text(path, str(args.get("content") or ""))
+        return ReactToolResult(result.ok, f"appended: {path}", result.__dict__)
+
+    async def _list_workspace(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 列出工作区文件。
+
+        :param args: 可含 path 的工具参数。
+        :returns: 文件路径列表。
+        """
+        path = str(args.get("path") or ".")
+        files = [
+            item.path
+            for item in self._workspace.list(path, limit=10_000)
+            if not item.is_dir
+        ]
+        return ReactToolResult(
+            True,
+            json.dumps(files, ensure_ascii=False, default=str),
+            {"files": files},
+        )
+
+    async def _grep_workspace(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 检索工作区文本。
+
+        :param args: 含 pattern、path 与 limit 的工具参数。
+        :returns: 匹配记录。
+        """
+        pattern = str(args.get("pattern") or "")
+        path = str(args.get("path") or ".")
+        limit = int(args.get("limit") or 100)
+        matches = await self._workspace.grep(pattern, path, limit=limit)
+        data = {"matches": [item.__dict__ for item in matches]}
+        return ReactToolResult(
+            True,
+            json.dumps(data, ensure_ascii=False, default=str),
+            data,
+        )
+
+    async def _dispatch_skill_tool(
+        self,
+        action: str,
+        args: dict[str, Any],
+        readonly: bool,
+    ) -> ReactToolResult:
+        """@brief 分派技能工具。
+
+        :param action: 技能工具名。
+        :param args: 工具参数。
+        :param readonly: 是否禁止改变环境。
+        :returns: 技能执行结果。
+        """
+        if action == "activate_skill":
+            return self._activate_skill(args)
+        if action == "deactivate_skill":
+            return self._deactivate_skill(args)
+        if action == "read_skill_file":
+            return self._read_skill_file(args)
+        return await self._execute_skill_script(args, readonly)
+
+    def _activate_skill(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 启用一个可见技能。
+
+        :param args: 含 skill_name 的参数。
+        :returns: 启用结果。
+        """
+        name = str(args.get("skill_name") or "")
+        activated, skill_id, doc = self.skill_runtime.activate_skill(name)
+        if activated:
+            return ReactToolResult(
+                True,
+                doc,
+                {"skill_id": skill_id, "skill_name": name, "activated": True},
+            )
+        error = "skill_doc_unavailable" if skill_id else "skill_not_resolved"
+        message = f"activate_skill failed: skill_name={name!r}, error={error}"
+        return ReactToolResult(
+            False,
+            message,
+            {"skill_id": skill_id, "skill_name": name, "activated": False, "error": error},
+        )
+
+    def _deactivate_skill(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 停用一个已启用技能。
+
+        :param args: 含 skill_name 的参数。
+        :returns: 停用结果。
+        """
+        removed, skill_id = self.skill_runtime.deactivate_skill(
+            str(args.get("skill_name") or "")
+        )
+        message = f"deactivated: {skill_id}" if removed else f"not active: {skill_id}"
+        return ReactToolResult(True, message, {"skill_id": skill_id, "removed": removed})
+
+    def _read_skill_file(self, args: dict[str, Any]) -> ReactToolResult:
+        """@brief 读取已启用技能的附属文件。
+
+        :param args: 含技能身份和 path 的参数。
+        :returns: 文件内容。
+        """
+        skill_id = self._resolve_skill_id_from_args(args)
+        path = str(args.get("path") or "")
+        content = self.skill_runtime.read_skill_file(skill_id, path)
+        return ReactToolResult(
+            bool(content),
+            content,
+            {"skill_id": skill_id, "path": path, "content_len": len(content or "")},
+        )
+
+    async def _execute_skill_script(
+        self,
+        args: dict[str, Any],
+        readonly: bool,
+    ) -> ReactToolResult:
+        """@brief 执行本地技能脚本或委托环境技能。
+
+        :param args: 技能脚本参数。
+        :param readonly: 是否禁止改变环境。
+        :returns: 执行结果。
+        """
+        skill_id = self._resolve_skill_id_from_args(args)
+        argv = args.get("argv")
+        argv_list = [str(item) for item in argv] if isinstance(argv, list) else []
+        if skill_id.startswith("env:"):
+            return await self._execute_env_skill(args, argv_list, readonly)
+        result = await self.skill_runtime.run_skill_script(
+            skill_id,
+            str(args.get("script_path") or ""),
+            argv_list,
+            timeout_sec=int(args.get("timeout_sec") or 30),
+        )
+        data = result.as_dict()
+        return ReactToolResult(
+            result.ok,
+            json.dumps(data, ensure_ascii=False, default=str),
+            data,
+        )
+
+    async def _execute_env_skill(
+        self,
+        args: dict[str, Any],
+        argv: list[str],
+        readonly: bool,
+    ) -> ReactToolResult:
+        """@brief 将环境技能委托给文本路由。
+
+        :param args: 技能工具参数。
+        :param argv: 命令参数。
+        :param readonly: 是否禁止改变环境。
+        :returns: 环境执行结果。
+        """
+        env_readonly = bool(args.get("readonly", False))
+        if readonly and not env_readonly:
+            return self._readonly_rejection("execute_skill_script")
+        instruction = self._build_env_skill_instruction(args, argv)
+        _, answer = await self.ask_env(
+            self._build_env_tool_context(args),
+            instruction,
+            readonly=env_readonly,
+            template_mode=True,
+        )
+        return ReactToolResult(
+            True,
+            str(answer or ""),
+            {"instruction": instruction, "readonly": env_readonly},
+        )
+
+    async def _dispatch_env_tool(
+        self,
+        args: dict[str, Any],
+        readonly: bool,
+    ) -> ReactToolResult:
+        """@brief 执行通用文本环境请求。
+
+        :param args: 环境请求参数。
+        :param readonly: 是否禁止改变环境。
+        :returns: 环境回答。
+        """
+        instruction = str(args.get("instruction") or "")
+        if not instruction:
+            return ReactToolResult(False, "ask_env requires instruction", {})
+        env_readonly = bool(args.get("readonly", False))
+        if readonly and not env_readonly:
+            return self._readonly_rejection("ask_env")
+        _, answer = await self.ask_env(
+            self._build_env_tool_context(args),
+            instruction,
+            readonly=env_readonly,
+            template_mode=True,
+        )
+        return ReactToolResult(
+            True,
+            str(answer or ""),
+            {"instruction": instruction, "template_mode": True},
+        )
+
+    # ------------------------------------------------------------------
+    # Path helpers
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _is_core_owned_workspace_path(path: str) -> bool:
+        """Return whether a workspace path is owned by agent core runtime.
+
+        Args:
+            path: Workspace-relative path requested by the LLM tool loop.
+
+        Returns:
+            True when generic workspace mutation tools must not edit the path.
+        """
+        normalized = str(path or "").replace("\\", "/").strip().lstrip("./")
+        return (
+            normalized == "AGENT.json"
+            or normalized == "MEMORY.md"
+            or normalized.startswith("memory/")
+            or normalized == "state/todos.json"
+            or normalized.startswith("state/daily_guidance/")
+        )
+
+    def _normalize_workspace_read_path(self, path: str) -> str:
+        """Map known agent-workspace absolute paths to this workspace.
+
+        Args:
+            path: Model-provided read path.
+
+        Returns:
+            Original relative path or a path relative to this agent workspace.
+        """
+        raw = str(path or "").strip()
+        if not raw:
+            return raw
+        candidate = Path(raw)
+        if not candidate.is_absolute():
+            return raw
+        parts = candidate.parts
+        agent_dir = self.workspace_root_path().name
+        for idx, part in enumerate(parts):
+            if part == agent_dir:
+                rel_parts = parts[idx + 1 :]
+                if rel_parts:
+                    return Path(*rel_parts).as_posix()
+        return raw
+
+    def _try_read_skill_path(self, path: str) -> tuple[str, str, str] | None:
+        """Resolve an escaping read path to a visible skill file's content.
+
+        Args:
+            path: The path the model tried to read (absolute or relative).
+
+        Returns:
+            ``(skill_id, relative_path, content)`` if the path maps to a file
+            inside a visible skill root, else ``None``.
+        """
+        resolved = self.skill_runtime.resolve_skill_path(path)
+        if resolved is None:
+            return None
+        skill_id, rel_path = resolved
+        content = self.skill_runtime.read_skill_file(skill_id, rel_path)
+        if not content:
+            return None
+        return skill_id, rel_path, content
+
+    def _build_env_tool_context(self, args: dict[str, Any]) -> dict[str, Any]:
+        """Build ask_env context from tool arguments.
+
+        Args:
+            args: ask_env tool arguments.
+
+        Returns:
+            Context dictionary passed to RouterBase.ask.
+        """
+        raw_ctx = args.get("ctx")
+        ctx = dict(raw_ctx) if isinstance(raw_ctx, Mapping) else {}
+        raw_variables = args.get("variables")
+        if isinstance(raw_variables, Mapping):
+            current = ctx.get("variables")
+            variables = dict(current) if isinstance(current, Mapping) else {}
+            variables.update(dict(raw_variables))
+            ctx["variables"] = variables
+        return ctx
+
+    def _build_env_skill_instruction(
+        self,
+        args: Mapping[str, Any],
+        argv: list[str],
+    ) -> str:
+        """Build an ask_env instruction for env skill calls sent to script execution.
+
+        Args:
+            args: Original tool arguments.
+            argv: Command-like arguments supplied by the model.
+
+        Returns:
+            Natural-language instruction for the environment router.
+        """
+        skill_name = str(args.get("skill_name") or "environment").strip()
+        if argv:
+            return (
+                f"Use the {skill_name} environment skill to perform: {' '.join(argv)}"
+            )
+        return f"Use the {skill_name} environment skill for the current state."
+
+    # ==================================================================
+    # ReAct loop (generic orchestration)
+    # ==================================================================
+    #
+    # The loop is generic: it builds messages via ``self.build_react_messages``
+    # (a subclass-provided prompt hook), dispatches the LLM via
+    # ``self._dispatcher.call``, executes tools via ``self._execute_react_tool``
+    # (which calls ``self.dispatch_react_tool`` polymorphically), and respects
+    # ``self._max_react_turns``.  Nothing person-specific is inlined here.
+
+    async def run_react_loop(self, request: ReactLoopRequest) -> str:
+        """@brief 运行唯一 ReAct 循环，直到收到严格 finish。
+
+        决策前先执行可选的决策自述钩子（单次无工具调用模型请求）；基类默认
+        不启用，行为与未引入钩子前完全一致。
+
+        :param request: 本次循环的完整输入。
+        :returns: finish 给出的回答或记忆摘要。
+        :raises RuntimeError: 回合耗尽或协议无效。
+        """
+        self._last_finish_memories = None
+        self.prepare_react_loop(request)
+        await self._run_prelude_decision_statement(request)
+        with self.trace_span(
+            "react.loop",
+            attributes={
+                "agent.tick": request.tick,
+                "operation.type": "react",
+                "react.max_turns": self._max_react_turns,
+                "react.readonly": request.readonly,
+            },
+        ):
+            for turn in range(1, self._max_react_turns + 1):
+                final = await self._run_react_turn(request, turn)
+                if final is not None:
+                    return final
+        raise RuntimeError("ReAct decision budget exhausted without a valid finish")
+
+    def prelude_decision_statement_request(self, request: ReactLoopRequest) -> dict[str, Any] | None:
+        """@brief 提供决策前决策自述的模型请求参数。
+
+        具体人物覆盖此钩子返回不含 tools 的模型请求参数字典以启用决策自述；
+        基类默认返回空值（不启用，行为不变）。
+
+        :param request: 本次循环输入。
+        :returns: 决策自述模型请求参数；不启用时为空。
+        """
+        del request
+        return None
+
+    def receive_prelude_decision_statement(self, request: ReactLoopRequest, decision_statement: str) -> None:
+        """@brief 接收已完成的决策前决策自述文本。
+
+        :param request: 本次循环输入。
+        :param decision_statement: 决策自述文本。
+        """
+        del request, decision_statement
+
+    async def _run_prelude_decision_statement(self, request: ReactLoopRequest) -> None:
+        """@brief 执行单次无工具调用的决策前决策自述。
+
+        :param request: 本次循环输入。
+        :raises RuntimeError: 决策自述请求携带工具或响应正文为空。
+        """
+        params = self.prelude_decision_statement_request(request)
+        if not params:
+            return
+        if "tools" in params:
+            logger.error("Decision statement request must not expose tools")
+            raise RuntimeError("Prelude decision_statement request must not expose tools")
+        response = await self._complete_prelude_decision_statement(params)
+        decision_statement = self._decision_statement_text(response)
+        self.receive_prelude_decision_statement(request, decision_statement)
+
+    async def _complete_prelude_decision_statement(self, params: dict[str, Any]) -> Any:
+        """@brief 调用一次决策自述模型并保存完整请求、响应或失败证据。
+
+        :param params: 子类提供的决策自述模型请求参数。
+        :returns: 原始模型响应。
+        """
+        if self._model_name is None or self._dispatcher is None:
+            logger.error("Decision statement model is not initialized")
+            raise RuntimeError("LLM is not initialized")
+        call_id = self._next_model_call_id(0)
+        await self._record_model_evidence(
+            ModelCallEvidence(
+                getattr(self, "_decision_context", None),
+                call_id,
+                "request",
+                0,
+                params,
+            )
+        )
+        try:
+            response = await self._dispatcher.call(**params)
+        except Exception as exc:
+            logger.error("Decision statement transport failed: %s", exc)
+            await self._record_model_evidence(
+                ModelCallEvidence(
+                    getattr(self, "_decision_context", None),
+                    call_id,
+                    "failure",
+                    0,
+                    params,
+                    error=repr(exc),
+                )
+            )
+            raise
+        await self._record_model_evidence(
+            ModelCallEvidence(
+                getattr(self, "_decision_context", None),
+                call_id,
+                "response",
+                0,
+                params,
+                response=self._serialize_model_response(response),
+            )
+        )
+        return response
+
+    @staticmethod
+    def _decision_statement_text(response: Any) -> str:
+        """@brief 严格提取决策自述正文。
+
+        :param response: 决策自述模型原始响应。
+        :returns: 非空决策自述文本。
+        :raises RuntimeError: 响应或正文缺失。
+        """
+        choices = getattr(response, "choices", None)
+        message = getattr(choices[0], "message", None) if choices else None
+        text = str(getattr(message, "content", "") or "").strip()
+        if not text:
+            logger.error("Decision statement returned empty content")
+            raise RuntimeError("Prelude decision_statement returned empty content")
+        return text
+
+    def prepare_react_loop(self, request: ReactLoopRequest) -> None:
+        """@brief 在每次循环开始前重置子类决策状态。
+
+        :param request: 本次循环输入。
+        """
+        del request
+        self._model_call_sequence = 0
+        self._last_model_call_id = ""
+        self._last_model_request: dict[str, Any] = {}
+        self._last_transport_attempts: tuple[dict[str, Any], ...] = ()
+        self._react_messages: list[dict[str, Any]] = []
+
+    async def _run_react_turn(
+        self,
+        request: ReactLoopRequest,
+        turn: int,
+    ) -> str | None:
+        """@brief 执行一个模型回合及其非 finish 工具。
+
+        :param request: 本次循环输入。
+        :param turn: 从一开始的回合号。
+        :returns: finish 结果；未结束时返回空值。
+        """
+        decisions = await self._call_react_llm(request)
+        finish = next((item for item in decisions if item.action == "finish"), None)
+        if finish is not None:
+            return self._finish_react_loop(finish, request.readonly)
+        for decision in decisions:
+            result = await self._execute_react_tool(
+                decision,
+                readonly=request.readonly,
+            )
+            self._append_react_tool_result(decision, result)
+            request.observations.append(
+                {
+                    "turn": turn,
+                    "action": decision.action,
+                    "ok": result.ok,
+                    "observation": result.observation,
+                    "data": result.data,
+                }
+            )
+        return None
+
+    def _append_react_tool_result(
+        self,
+        decision: ReactDecision,
+        result: ReactToolResult,
+    ) -> None:
+        """@brief 把实际工具结果关联到提供商分配的调用身份。
+
+        :param decision: 已执行的原生工具调用。
+        :param result: 工具返回的实际结构化结果。
+        """
+        if not decision.tool_call_id:
+            logger.error("Native tool call id is unavailable")
+            raise RuntimeError("Native tool call id is unavailable")
+        payload = {
+            "ok": result.ok,
+            "observation": result.observation,
+            "data": result.data,
+        }
+        self._react_messages.append(
+            {
+                "role": "tool",
+                "tool_call_id": decision.tool_call_id,
+                "content": json.dumps(payload, ensure_ascii=False, default=str),
+            }
+        )
+
+    def _finish_react_loop(
+        self,
+        decision: ReactDecision,
+        readonly: bool,
+    ) -> str:
+        """@brief 保存 finish 记忆并形成步骤结果。
+
+        :param decision: 已严格验证的 finish 决策。
+        :param readonly: 是否为外部只读问答。
+        :returns: 最终回答或记忆摘要。
+        """
+        if readonly:
+            return decision.final
+        memories = decision.args["memories"]
+        self._last_finish_memories = memories
+        return _brief_memories_summary(memories)
+
+    async def _call_react_llm(
+        self,
+        request: ReactLoopRequest,
+    ) -> list[ReactDecision]:
+        """@brief 构造提示并执行一次严格模型调用。
+
+        :param request: 当前 ReAct 循环输入。
+        :returns: 严格解析的原生工具决策；可反馈的协议错误返回空列表。
+        :raises RuntimeError: 模型或证据内部状态不一致。
+        """
+        messages = self._react_message_history(request)
+        tools = self.build_react_tool_schemas(readonly=request.readonly)
+        response = await self._complete_react_once(messages, tools, 1)
+        decisions, error = self._parse_react_responses(
+            response,
+            readonly=request.readonly,
+        )
+        if not error:
+            error = self._validate_react_tool_names(decisions, tools)
+        if not error:
+            error = self.validate_react_decisions(decisions, request.readonly)
+        await self._record_react_response(response, 1, error)
+        if error:
+            logger.error("Agent %s ReAct protocol validation failed: %s", self.id, error)
+            self._append_react_protocol_feedback(messages, response, error)
+            return []
+        self._accept_react_response(messages, response, decisions)
+        return decisions
+
+    def _append_react_protocol_feedback(
+        self,
+        messages: list[dict[str, Any]],
+        response: Any,
+        error: str,
+    ) -> None:
+        """@brief 把已留证的模型协议错误加入下一回合消息历史。
+
+        :param messages: 产生错误响应的实际请求消息。
+        :param response: 已持久化的模型响应。
+        :param error: 本地协议校验错误。
+        """
+        content = self._protocol_feedback_content(error)
+        tool_calls = self._feedback_tool_calls(response)
+        if tool_calls is None:
+            self._react_messages = [*messages, {"role": "user", "content": content}]
+            return
+        choices = getattr(response, "choices", None)
+        message = getattr(choices[0], "message", None)
+        assistant = self._assistant_tool_message(message, tool_calls)
+        results = [
+            {"role": "tool", "tool_call_id": item["id"], "content": content}
+            for item in tool_calls
+        ]
+        self._react_messages = [*messages, assistant, *results]
+
+    def _feedback_tool_calls(self, response: Any) -> list[dict[str, Any]] | None:
+        """@brief 取得可安全配对到下一请求的完整原生工具调用。
+
+        :param response: 已持久化的模型响应。
+        :returns: 完整调用列表；结构破损时返回空值。
+        """
+        choices = getattr(response, "choices", None)
+        message = getattr(choices[0], "message", None) if choices else None
+        raw_calls = getattr(message, "tool_calls", None) or []
+        if not isinstance(raw_calls, (list, tuple)) or not raw_calls:
+            return None
+        call_ids: list[str] = []
+        for item in raw_calls:
+            function = getattr(item, "function", None)
+            call_id = getattr(item, "id", None)
+            name = getattr(function, "name", None)
+            arguments = getattr(function, "arguments", None)
+            if getattr(item, "type", None) != "function":
+                return None
+            if not isinstance(call_id, str) or not call_id.strip():
+                return None
+            if not isinstance(name, str) or not name.strip() or not isinstance(arguments, str):
+                return None
+            call_ids.append(call_id.strip())
+        if len(set(call_ids)) != len(call_ids):
+            return None
+        return [self._serialize_tool_call(item) for item in raw_calls]
+
+    @staticmethod
+    def _protocol_feedback_content(error: str) -> str:
+        """@brief 形成不包含原始响应的固定协议纠错内容。
+
+        :param error: 本地协议校验错误。
+        :returns: 模型可见的结构化纠错内容。
+        """
+        payload = {
+            "ok": False,
+            "executed": False,
+            "error_type": "protocol_validation_error",
+            "error": error,
+            "instruction": "Submit a new response using only the current tools and schemas.",
+        }
+        return json.dumps(payload, ensure_ascii=False)
+
+    def _react_message_history(self, request: ReactLoopRequest) -> list[dict[str, Any]]:
+        """@brief 取得本决策只构造一次的提示和原生工具历史。
+
+        :param request: 当前 ReAct 循环输入。
+        :returns: 可追加 Schema 纠正反馈的消息副本。
+        """
+        if not self._react_messages:
+            self._react_messages = self.build_react_messages(request)
+        return list(self._react_messages)
+
+    def _accept_react_response(
+        self,
+        messages: list[dict[str, Any]],
+        response: Any,
+        decisions: list[ReactDecision],
+    ) -> None:
+        """@brief 保存已通过协议校验的真实 assistant 工具消息。
+
+        :param messages: 本次模型实际收到的消息。
+        :param response: 本次模型实际返回的响应。
+        :param decisions: 从该响应解析的工具决策。
+        """
+        choices = getattr(response, "choices", None)
+        message = getattr(choices[0], "message", None) if choices else None
+        tool_calls = getattr(message, "tool_calls", None) or []
+        if len(tool_calls) != len(decisions):
+            raise RuntimeError("Accepted tool calls do not match parsed decisions")
+        serialized = [self._serialize_tool_call(item) for item in tool_calls]
+        expected = [item.tool_call_id for item in decisions]
+        if [item["id"] for item in serialized] != expected:
+            raise RuntimeError("Accepted tool call identities changed after parsing")
+        assistant = self._assistant_tool_message(message, serialized)
+        self._react_messages = [*messages, assistant]
+
+    @staticmethod
+    def _assistant_tool_message(
+        message: Any,
+        tool_calls: list[dict[str, Any]],
+    ) -> dict[str, Any]:
+        """@brief 构造保留 reasoning_content 的 assistant 工具消息。
+
+        :param message: 模型响应中的原始 assistant 消息。
+        :param tool_calls: 已序列化的原生工具调用。
+        :returns: 可回传给后续带 tools 请求的 assistant 消息。
+        """
+        assistant: dict[str, Any] = {
+            "role": "assistant",
+            "content": getattr(message, "content", None),
+            "tool_calls": tool_calls,
+        }
+        reasoning = getattr(message, "reasoning_content", None)
+        if reasoning:
+            assistant["reasoning_content"] = reasoning
+        return assistant
+
+    @staticmethod
+    def _serialize_tool_call(tool_call: Any) -> dict[str, Any]:
+        """@brief 保留实际原生工具调用身份、名称和原始参数文本。
+
+        :param tool_call: 模型响应中的原生工具调用对象。
+        :returns: 可直接用于后续 Chat Completion 的工具调用消息。
+        """
+        function = getattr(tool_call, "function", None)
+        return {
+            "id": str(getattr(tool_call, "id", "") or ""),
+            "type": "function",
+            "function": {
+                "name": str(getattr(function, "name", "") or ""),
+                "arguments": str(getattr(function, "arguments", "") or "{}"),
+            },
+        }
+
+    @staticmethod
+    def _validate_react_tool_names(
+        decisions: list[ReactDecision],
+        tools: list[dict[str, Any]],
+    ) -> str:
+        """@brief 校验模型只能调用当前请求公开的工具。
+
+        :param decisions: 已完成语法解析的模型决策。
+        :param tools: 本次模型请求实际公开的工具 Schema。
+        :returns: 空字符串或英文协议错误。
+        """
+        allowed = {
+            str(item.get("function", {}).get("name", ""))
+            for item in tools
+            if item.get("type") == "function"
+        }
+        unknown = sorted({item.action for item in decisions} - allowed)
+        return "" if not unknown else f"unknown native tool calls: {unknown}"
+
+    def validate_react_decisions(
+        self,
+        decisions: list[ReactDecision],
+        readonly: bool,
+    ) -> str:
+        """@brief 允许具体人物在执行前校验完整请求模型和批次语义。
+
+        :param decisions: 已完成通用协议验证的模型决策。
