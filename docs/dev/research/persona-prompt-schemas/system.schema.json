{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system.schema.json",
  "title": "系统层",
  "description": "人物的执行职责与世界交互规则。每条规则只在这里出现一次，工具 description 只说明用途；人物姓名与身份只在人设层。",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "role", "rules"],
  "properties": {
    "layer": {"const": "系统层"},
    "role": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
