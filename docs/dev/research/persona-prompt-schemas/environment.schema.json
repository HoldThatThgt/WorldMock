{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment.schema.json",
  "title": "环境层",
  "description": "当前观察时刻、身体感受及所在地点或路程的静态属性，不包含目标、消息、活动和历史。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "observed_at",
    "body",
    "location"
  ],
  "properties": {
    "layer": {
      "const": "环境层"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appetite",
        "sleepiness",
        "energy"
      ],
      "properties": {
        "appetite": {
          "type": "string",
          "minLength": 1
        },
        "sleepiness": {
          "type": "string",
          "minLength": 1
        },
        "energy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_kind",
        "name",
        "place_type",
        "fixed_rules"
      ],
      "properties": {
        "session_kind": {
          "enum": [
            "stay",
            "transit"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "place_type": {
          "type": "string",
          "minLength": 1
        },
        "fixed_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
